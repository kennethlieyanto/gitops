{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "kubernetes": {
            "type": "local",
            "command": ["npx", "-y", "kubernetes-mcp-server@latest"],
            "enabled": true
        },
        "terraform": {
            "type": "local",
            "command": ["docker", "run", "-i", "--rm", "hashicorp/terraform-mcp-server:1.3.0"],
            "enabled": true
        }
    }
}
