{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "kubernetes": {
            "type": "local",
            "command": ["npx", "-y", "kubernetes-mcp-server@latest"],
            "enabled": true
        },
        "terraform": {
            "type": "local",
            "command": [
                "docker",
                "run",
                "-i",
                "--rm",
                "hashicorp/terraform-mcp-server:1.3.0"
            ],
            "enabled": false
        },
        "ssh": {
            "type": "local",
            "command": ["npx", "-y", "ssh-mcp"],
            "enabled": false
        }
    },
    "references": {
        "k8s-gitops": {
            "path": "../../work/kubernetes-gitops",
            "description": "Use this as a reference when I want to add some other components."
        }
    }
}
