{% for site in caddy_sites %}
{{ site.domain }} {
    tls {
        dns cloudflare {env.CLOUDFLARE_API_TOKEN}
    }

    reverse_proxy {% if site.tls %}https{% else %}http{% endif %}://{{ site.upstream }} {
        {% if site.tls_insecure_skip_verify %}
        transport http {
            tls_insecure_skip_verify
        }
        {% endif %}
    }
}
{% endfor %}
